{
  "manifest_version": 3,
  "name": "void pip",
  "version": "1.0",
  "description": "Float the page's video in a picture-in-picture card (Alt+P toggles).",
  "permissions": ["scripting", "activeTab"],
  "action": { "default_title": "Float video (Alt+P)" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+P" } }
  },
  "background": { "service_worker": "background.js" }
}
