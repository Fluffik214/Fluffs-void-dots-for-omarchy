{
  "manifest_version": 3,
  "name": "void pip",
  "version": "1.2",
  "description": "Float the page's video in a picture-in-picture card (Alt+P toggles); on YouTube the card's next button skips ads.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_title": "Float video (Alt+P)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-skipad.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
