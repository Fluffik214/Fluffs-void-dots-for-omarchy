{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // void — black hole logo, violet keys, grey rules
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/void.txt",
    "color": { "1": "magenta" },
    "padding": { "top": 1, "right": 4, "left": 2 }
  },
  "display": {
    "disableLinewrap": true,
    "separator": "  ",
    "color": { "keys": "magenta", "title": "white" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}\u001b[90m @ \u001b[0m{host-name}" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────────" },
    {
      "type": "command",
      "key": "os  ",
      "text": "echo \"Omarchy $(omarchy-version)\""
    },
    { "type": "kernel", "key": "ker " },
    { "type": "wm", "key": "wm  " },
    {
      "type": "command",
      "key": "thm ",
      "text": "echo \"$(omarchy-theme-current)\""
    },
    { "type": "terminal", "key": "term" },
    { "type": "packages", "key": "pkgs", "format": "{all}" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────────" },
    { "type": "cpu", "key": "cpu ", "format": "{name}" },
    { "type": "gpu", "key": "gpu ", "detectionMethod": "pci", "format": "{name}" },
    { "type": "memory", "key": "mem " },
    { "type": "disk", "key": "disk", "folders": "/" },
    { "type": "uptime", "key": "up  " },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────────" },
    {
      "type": "custom",
      "format": "\u001b[90m●  \u001b[31m●  \u001b[32m●  \u001b[33m●  \u001b[34m●  \u001b[35m●  \u001b[36m●  \u001b[37m●"
    },
    "break"
  ]
}
